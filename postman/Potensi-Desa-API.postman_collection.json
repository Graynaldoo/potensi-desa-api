    },
    {
      "name": "09 GET /potensi/:id (publik, kini terbit -> 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/potensi/{{potensiId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "potensi",
            "{{potensiId}}"
          ]
        },
        "description": "UF01 langkah 5 dan 6."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Ada tautan WhatsApp dan foto', () => { const d = pm.response.json().data; pm.expect(d.whatsapp_link).to.include('wa.me'); pm.expect(d.foto.length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 GET /potensi (cari + filter kategori)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/potensi?q=uji&kategori={{kategoriId}}&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "potensi"
          ],
          "query": [
            {
              "key": "q",
              "value": "uji"
            },
            {
              "key": "kategori",
              "value": "{{kategoriId}}"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "UF01 langkah 3 dan 4."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Hanya terbit', () => pm.response.json().data.forEach(p => pm.expect(p.status).to.eql('terbit')));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 GET /potensi/peta (GeoJSON untuk Leaflet)",
