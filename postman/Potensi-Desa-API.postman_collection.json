            ]
          }
        }
      ]
    },
    {
      "name": "08 PUT /potensi/:id (admin menerbitkan)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
