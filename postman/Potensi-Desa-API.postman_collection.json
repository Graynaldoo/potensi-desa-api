    {
      "name": "05 POST /kategori (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/kategori",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "kategori"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama_kategori\": \"Kategori Uji Postman\",\n  \"deskripsi\": \"Dibuat dari Postman\",\n  \"icon\": \"star\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('kategoriId', pm.response.json().data.id_kategori);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 POST /potensi (admin, draft + foto)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/potensi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "potensi"
          ]
        },
        "description": "UF02 langkah 5 dan 6. id_kategori diambil otomatis dari langkah 05.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_kategori\": \"{{kategoriId}}\",\n  \"nama_potensi\": \"Potensi Uji Postman\",\n  \"deskripsi\": \"Data uji dari Postman\",\n  \"alamat\": \"Dusun Uji\",\n  \"latitude\": -8.0661,\n  \"longitude\": 111.9012,\n  \"kontak\": \"0812 3456 7890\",\n  \"foto\": [\n    {\n      \"url_foto\": \"https://example.com/foto-uji.jpg\",\n      \"caption\": \"Foto uji\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const d = pm.response.json().data;",
              "pm.test('Status default draft', () => pm.expect(d.status).to.eql('draft'));",
              "pm.collectionVariables.set('potensiId', d.id_potensi);"
            ]
          }
        }
      ]
    },
