# Salin file ini menjadi .env lalu sesuaikan nilainya.
PORT=3000
# Format: postgresql://USER:PASSWORD@HOST:5432/NAMA_DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/potensi_desa
# Kunci rahasia untuk menandatangani token login admin. Minimal 32 karakter, acak.
# JANGAN di-commit ke GitHub.
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter-ya
JWT_EXPIRES_IN=8h
# Opsional
CORS_ORIGIN=*
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
